# DirectPilot Beta local configuration template
# Copy to .env for local development. Never commit real .env files or real secrets.

# local | staging | production-like labels for diagnostics only
APP_ENV=local

# Default safe mode. Keep live_readonly unless you explicitly need gated live writes.
# Allowed: mock, sandbox, live_readonly, live_write
DIRECTPILOT_MODE=live_readonly

# Yandex Direct OAuth app/client settings
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_OAUTH_TOKEN=
YANDEX_REDIRECT_URI=https://oauth.yandex.ru/verification_code

# Yandex Search API v2 / Wordstat
YANDEX_SEARCH_API_KEY=
YANDEX_SEARCH_FOLDER_ID=

# Yandex Metrika read-only token
YANDEX_METRIKA_OAUTH_TOKEN=
